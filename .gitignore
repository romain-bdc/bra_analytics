# XML brut : jamais commite. Seules les fixtures de test sont versionnees.
data/
*.xml
!tests/fixtures/*.xml
# Series de bulletins consecutifs (tests du bloc risque) : des fixtures elles
# aussi, tenues hors de tests/fixtures/ parce que `build()` y lit recursivement.
!tests/series/**/*.xml

# Sorties et journaux d'execution
warehouse/
logs/
*.parquet
*.duckdb

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# tableau de bord genere par `bra dashboard` (le gabarit du meme nom,
# sous src/, doit rester versionne : ancrer le motif a la racine)
/dashboard.html
# carte d accueil generee par `bra carte` (meme raison : ancrer a la racine)
/carte.html
/fiche.html
/comparaison.html
# site statique genere par `bra site`
/site/
